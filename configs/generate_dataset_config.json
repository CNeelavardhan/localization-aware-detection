{
  "data_dir": "data",
  "coco_images_dir": "data/coco/val2017",
  "coco_annotations_file": "data/coco/annotations/instances_val2017.json",
  "target_count": 1200,
  "model_id": "stabilityai/stable-diffusion-xl-base-1.0",
  "device": "cpu",
  "torch_dtype": "float32",
  "guidance_scale": 7.5,
  "inference_steps": 30,
  "negative_prompt_default": "",
  "min_mask_area_ratio": 0.015,
  "max_mask_area_ratio": 0.6,
  "seed": 42,
  "max_retries": 3,
  "retry_backoff_seconds": 5.0,
  "dry_run": false,
  "enable_attention_slicing": true,
  "enable_xformers": false,
  "enable_cpu_offload": false,
  "log_level": "INFO",
  "manifest_filename": "manifest.json",
  "csv_summary_filename": "dataset_summary.csv",
  "manipulation_map": {
    "person": {"type": "replacement", "target": "firefighter"},
    "truck": {"type": "replacement", "target": "bus"},
    "cat": {"type": "replacement", "target": "fox"},
    "car": {"type": "replacement", "target": "truck"},
    "dog": {"type": "replacement", "target": "wolf"},
    "cow": {"type": "replacement", "target": "horse"},
    "horse": {"type": "replacement", "target": "zebra"},
    "boat": {"type": "replacement", "target": "ship"},
    "bird": {"type": "replacement", "target": "eagle"},
    "airplane": {"type": "replacement", "target": "fighter jet"},
    "train": {"type": "removal", "target": null},
    "motorcycle": {"type": "removal", "target": null},
    "elephant": {"type": "removal", "target": null},
    "zebra": {"type": "removal", "target": null},
    "bus": {"type": "removal", "target": null},
    "bicycle": {"type": "removal", "target": null},
    "bear": {"type": "removal", "target": null}
  }
